<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.csiq6823.zenlife.ui.DashboardFragment"
        android:label="ZenLife Dashboard">
        <action
            android:id="@+id/action_dashboard_to_breakDialog"
            app:destination="@id/comfortBreakDialog" />
        <action
            android:id="@+id/action_dashboard_to_confirmDeleteDialog"
            app:destination="@id/confirmDeleteDialog" />
    </fragment>

    <dialog
        android:id="@+id/comfortBreakDialog"
        android:name="com.csiq6823.zenlife.ui.ComfortBreakDialog"
        android:label="Comfort Break" />

    <dialog
        android:id="@+id/confirmDeleteDialog"
        android:name="com.csiq6823.zenlife.ui.ConfirmDeleteDialog"
        android:label="Confirm Delete" />
</navigation>
